# ============================
# MeatPe Bot - Environment Vars
# ============================

# Server
PORT=3000
BASE_URL=http://localhost:3000
ADMIN_WHATSAPP=whatsapp:+91XXXXXXXXXX
SHOP_NAME=MeatPe
TAGLINE=Fresh Meat in 30 Minutes — Taaza, Tezz, Trusted

# Twilio WhatsApp (Free Sandbox)
# Get from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Twilio bot enabled? 'off' = only Web orders + manual replies via WhatsApp Business App
WHATSAPP_BOT_ENABLED=off

# Auto-notify customer on status change?
# 'on' only when an official WhatsApp Business API is connected.
WHATSAPP_AUTO_NOTIFY=off

# Instagram Graph API (Business / Creator account required)
# Get long-lived token: https://developers.facebook.com/tools/explorer/
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FB_PAGE_ID=000000000000000

# Database
DB_PATH=./data/meatpe.db

# Delivery thresholds (INR)
DELIVERY_FREE_ABOVE=699
DELIVERY_LOW_BELOW=399
DELIVERY_FEE_LOW=29
DELIVERY_FEE_MID=19
REWARD_THRESHOLD=500
REWARD_AMOUNT=30

# ============================
# Authentication Provider Configuration
# ============================
# Options: msg91 | firebase | twilio
# Change this ONE variable to switch authentication providers
# No code changes required to migrate between providers
AUTH_PROVIDER=msg91

# MSG91 Configuration (Production-ready OTP provider)
# Sign up: https://control.msg91.com/signup/
# Get your AUTH_KEY from: https://control.msg91.com/user/index.php#api
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_template_id_here
MSG91_SENDER_ID=MSGIND
MSG91_WHATSAPP_NUMBER=your_whatsapp_business_number

# Firebase Configuration (Optional - for Firebase Phone Auth)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=your-private-key
# FIREBASE_CLIENT_EMAIL=your-client-email
# FIREBASE_API_KEY=your-api-key
# FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
